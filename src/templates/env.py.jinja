{{ env_prefix }}_APP_NAME={{ project_name }}
{{ env_prefix }}_APP_DESCRIPTION=A {{ project_name }} FastAPI service scaffolded with faststrapy
{{ env_prefix }}_APP_VERSION=0.1.0
{{ env_prefix }}_APP_ENVIRONMENT=dev

{{ env_prefix }}_SERVER_NAME={{ project_name }}
{{ env_prefix }}_SERVER_PATH=main:app
{{ env_prefix }}_SERVER_HOST=0.0.0.0
{{ env_prefix }}_SERVER_PORT=8000
{{ env_prefix }}_SERVER_RELOAD=true
{{ env_prefix }}_SERVER_BASE_API=api/v1
{% if use_database %}

{{ env_prefix }}_DATABASE_LOCAL_NAME={{ project_name }}_local
{{ env_prefix }}_DATABASE_LOCAL_URL={% if database_name == "postgres" %}{% if database_type == "async" %}postgresql+asyncpg://user:password@localhost:5432/{{ project_name }}{% else %}postgresql+psycopg2://user:password@localhost:5432/{{ project_name }}{% endif %}{% else %}sqlite+aiosqlite:///./{{ project_name }}.db{% endif %}

{{ env_prefix }}_DATABASE_PRODUCTION_NAME={{ project_name }}_prod
{{ env_prefix }}_DATABASE_PRODUCTION_URL=replace-with-your-neon-or-production-database-url
{{ env_prefix }}_DATABASE_AUTO_COMMIT=false
{{ env_prefix }}_DATABASE_AUTO_FLUSH=false
{{ env_prefix }}_DATABASE_ECHO_LOGS=true
{% endif %}

